#!/bin/sh
set -e

echo "🔍 Running pre-commit checks..."

# 1. Format and lint staged files
echo "✨ Running lint-staged (oxlint + prettier)..."
npx lint-staged

# 2. Typecheck TypeScript
echo "📐 Checking TypeScript types..."
npm run typecheck

# 3. JiTTesting Pedagogical Invariants
echo "🛡️  Running JiTTesting Pedagogical Invariants..."
npm test

echo "✅ All pre-commit checks passed cleanly!"
exit 0
